{
  "name": "boomerang-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "100% completion tracker for Ocarina of Time (Switch 2 remake) saves, as run by Hookshot.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "sav": "tsx src/cli/sav.ts",
    "build-checklist": "tsx scripts/build-checklist.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dist": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "dist-electron/main.cjs",
  "productName": "Boomerang Tracker",
  "build": {
    "appId": "io.github.boomerang-tracker",
    "productName": "Boomerang Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/*.map",
      "data/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Boomerang-Tracker-${version}-portable.exe"
    },
    "asar": true
  }
}
